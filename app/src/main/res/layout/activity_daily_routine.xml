<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="22dp"
        android:paddingRight="18dp"
        android:paddingBottom="30dp">

        <Button
            android:id="@+id/dailyBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_secondary"
            android:minHeight="48dp"
            android:text="@string/back_to_home"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="میرے روزانہ کے اذکار"
            android:textColor="@color/green_dark"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dailySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
           
            android:gravity="center"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dailyEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/settings_panel_background"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:padding="18dp"
            android:text="ابھی کوئی ذکر شامل نہیں۔ کسی بھی کیٹیگری میں جائیں اور ‘روزانہ کے معمول میں شامل کریں’ دبائیں۔"
            android:textColor="#655D50"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/dailyItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/resetDailyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_secondary"
            android:minHeight="58dp"
            android:text="آج کا معمول دوبارہ شروع کریں"
            android:textAllCaps="false"
            android:textColor="#8A1C1C"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
