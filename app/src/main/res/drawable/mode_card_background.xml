<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F0E7D5" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#CBBE9E" />
            <padding android:left="18dp" android:top="15dp" android:right="18dp" android:bottom="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFCF5" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#E1D6BC" />
            <padding android:left="18dp" android:top="15dp" android:right="18dp" android:bottom="15dp" />
        </shape>
    </item>
</selector>
